{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Toronto",
  "rebaseWhen": "conflicted",
  "commitBodyTable": true,
  "printConfig": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "enabledManagers": [
    "asdf",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "gomod",
    "npm"
  ],
  "packageRules": [
    {
      "description": "Go is pinned in .tool-versions, go.mod and the Dockerfile; CI fails if they drift, so update them in one PR.",
      "matchManagers": [
        "asdf",
        "dockerfile",
        "gomod"
      ],
      "matchPackageNames": [
        "golang",
        "go"
      ],
      "groupName": "go toolchain"
    },
    {
      "description": "Node is pinned in .tool-versions and the Dockerfile; CI fails if they drift, so update them in one PR.",
      "matchManagers": [
        "asdf",
        "dockerfile"
      ],
      "matchPackageNames": [
        "node",
        "nodejs"
      ],
      "groupName": "node toolchain"
    },
    {
      "matchManagers": [
        "asdf"
      ],
      "commitMessageTopic": "tool {{depName}}",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "tools",
      "addLabels": [
        "tools"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "commitMessageTopic": "docker {{depName}}",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "docker",
      "bumpVersion": "patch",
      "addLabels": [
        "docker"
      ]
    },
    {
      "matchDatasources": [
        "github-actions"
      ],
      "commitMessageTopic": "github action {{depName}}",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci",
      "addLabels": [
        "ci"
      ]
    },
    {
      "matchDatasources": [
        "gomod"
      ],
      "commitMessageTopic": "go module {{depName}}",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "addLabels": [
        "go"
      ]
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "commitMessageTopic": "npm package {{depName}}",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "addLabels": [
        "web"
      ]
    },
    {
      "description": "The browser of the browser tests comes with this package, so the two always change together.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@playwright/test",
        "@axe-core/playwright"
      ],
      "groupName": "browser tests"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "addLabels": [
        "patch"
      ]
    }
  ],
  "labels": [
    "renovate"
  ]
}
