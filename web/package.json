{
  "name": "beacon-web",
  "private": true,
  "version": "0.0.0",
  "description": "The web interface of Beacon, a single-page app on the REST API. Built into internal/web/dist and embedded in the binary.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "dev:beacon": "node e2e/serve.mjs --dev",
    "build": "tsc --build && vite build",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "openapi-typescript ../internal/api/openapi.yaml --output src/api/schema.d.ts",
    "generate:check": "openapi-typescript ../internal/api/openapi.yaml --output src/api/schema.d.ts --check",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
